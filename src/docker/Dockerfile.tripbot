# syntax=docker/dockerfile:1

# Keep native dependencies on the same Node major, Debian release, and libc in every stage.
FROM node:22-bookworm AS dependencies
WORKDIR /workspaces/tripbot
COPY package.json package-lock.json ./
RUN HUSKY=0 npm ci --no-audit --no-fund

FROM dependencies AS development
ENV NODE_ENV=development
RUN apt-get update \
    && apt-get install -y --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*
COPY .devcontainer/.tmux.conf /root/.tmux.conf
COPY . .
RUN npm run db:generate

# Production does not depend on the development image or its tools.
FROM dependencies AS build
COPY . .
RUN npm run db:generate \
    && npx tsc \
    && npx tsc-alias \
    && npx tsc --project tsconfig.prisma.json \
    && rm -f build/prisma.config.js build/prisma.config.js.map

# Prune the installed tree, preserving native install artifacts and the lockfile's versions.
FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim AS production
ENV NODE_ENV=production
ENV PM2_HOME=/home/node/.pm2
WORKDIR /workspaces/tripbot
# Prisma requires OpenSSL; keep package metadata and npm's cache out of the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pm2@7.1.2 --no-audit --no-fund \
    && npm cache clean --force

COPY --from=production-dependencies /workspaces/tripbot/node_modules ./node_modules
COPY --from=build /workspaces/tripbot/build ./build
COPY --from=build /workspaces/tripbot/package.json /workspaces/tripbot/package-lock.json ./
# Clients are generated outside node_modules. Only schemas and migrations need source paths at runtime.
COPY --from=build /workspaces/tripbot/src/prisma/tripbot/generated ./src/prisma/tripbot/generated
COPY --from=build /workspaces/tripbot/src/prisma/moodle/generated ./src/prisma/moodle/generated
COPY src/prisma/tripbot/schema.prisma ./src/prisma/tripbot/schema.prisma
COPY src/prisma/moodle/schema.prisma ./src/prisma/moodle/schema.prisma
COPY src/prisma/tripbot/migrations ./src/prisma/tripbot/migrations
COPY prisma.config.mjs ./prisma.config.mjs
COPY tsconfig.json ./tsconfig.json
# Runtime data refreshes write to build/assets/data.
COPY --chown=node:node assets ./build/assets
COPY src/docker/entrypoint.sh ./entrypoint.sh
COPY src/docker/readiness.js ./readiness.js
RUN chmod 755 ./entrypoint.sh \
    && mkdir -p /home/node/.pm2 \
    && chown node:node /home/node/.pm2
USER node
HEALTHCHECK --interval=5s --timeout=5s --start-period=15s --retries=3 \
    CMD ["node", "/workspaces/tripbot/readiness.js"]
ENTRYPOINT ["/workspaces/tripbot/entrypoint.sh"]
