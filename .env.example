# Copy this file and rename it as .env in the same directory
# Fill in the REQUIRED values

# REQUIRED Discord Bot settings
DISCORD_GUILD_ID = 960606557622657026 # Keep this as the dev server
DISCORD_OWNER_ID = 1234 # Your discord ID
DISCORD_CLIENT_ID = 1234 # In your Discord Developer Portal
DISCORD_CLIENT_TOKEN = abc123 # In your Discord Developer Portal
PRISMA_DB_URL = postgres://tripsit:SuperSecure123@tripbot_database:5432/tripsit
POSTGRES_DB_URL = postgres://tripsit:SuperSecure123@tripbot_database:5432/tripsit

# REQUIRED Database password
# This should be the same as the PRISMA_DB_URL and POSTGRS_DB_URL passwords
POSTGRESQL_PASSWORD = SuperSecure123

# Keep as development
NODE_ENV = development

# Feel free to change
TZ = "America/Chicago"

# Used for docker
COMPOSE_PROJECT_NAME = 'tripbot'

#### Everything after this is OPTIONAL ####

# Domains
DNS_DOMAIN = tripsit.io

# PG Admin
PGADMIN_PASSWORD = SuperSecure123

# Discord OAuth
DISCORD_CLIENT_SECRET = <Optional>
DISCORD_CLIENT_REDIRECT_URI = <Optional>

# Matrix bot 
MATRIX_ACCESS_TOKEN = <Optional>

# IRC bot (connects only when IRC_PASSWORD is set). Uncomment and fill in only what you need: a value left as
# a placeholder is read literally and replaces the default.
# IRC_PASSWORD = <Optional: NickServ password, used for SASL>
# IRC_USERNAME = <Optional: NickServ account, defaults to TripBot>
# IRC_NICK = <Optional: defaults to IRC_USERNAME>
# IRC_SERVER = <Optional: defaults to irc.tripsit.io in development, irc.tripsit.me in production>
# IRC_PORT = <Optional: defaults to 6697>
# IRC_TLS = <Optional: set to false to disable TLS>
# IRC_CHANNELS = <Optional: comma-separated override; defaults to every bridged channel>
# IRC_OPER_NAME = <Optional: oper block name in ircd.yaml; the bot sends OPER after connecting>
# IRC_OPER_PASSWORD = <Optional: plaintext oper password (ircd.yaml stores its hash)>
# IRC_BOTPREFIX = <Optional: command prefix, defaults to !>

# Telegram bot
TELEGRAM_TOKEN = <Optional>

# OpenAI (translation and RPG flair review)
OPENAI_API_ORG = <Optional>
OPENAI_API_KEY = <Optional>

# Uptime monitor: an Uptime Kuma push URL, pinged every minute while Discord (and IRC, if configured) is connected
# HEARTBEAT_URL = <Optional>

# Other API Tokens
MOODLE_TOKEN = <Optional> # For Moodle API
GITHUB_TOKEN = <Optional> # For GitHub API (also pushes branches and opens PRs for the code agent)
CLAUDE_CODE_OAUTH_TOKEN = <Optional> # Enables "@tripbot fix ..." for developers (from `claude setup-token`)
CODE_AGENT_REPO = <Optional> # Path of the git checkout the code agent branches from (defaults to the bot's cwd)
RAPID_TOKEN = <Optional> # For RapidAPI
WOLFRAM_TOKEN = <Optional> # For WolframAlpha API
IMGUR_ID = <Optional> # For Imgur API
IMGUR_SECRET = <Optional> # For Imgur API
YOUTUBE_TOKEN = <Optional> # For YouTube API
IMDB_TOKEN = <Optional> # For IMDB API
MODERATE_HATESPEECH_TOKEN = <Optional> # For Hate Speech API